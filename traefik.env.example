# Your DNS host's API login, for Traefik only -- see https.env.example and
# README, "Optional: HTTPS on your network". Copy to traefik.env next to
# docker-compose.yml and `chmod 600 traefik.env`. The app container never
# reads this file.
#
# Variable names are your DNS host's, from its page in
# https://go-acme.github.io/lego/dns/ -- give the token only DNS access,
# and an expiry date if the host allows it.

# Cloudflare: an API token with Zone -> DNS -> Edit on that domain only.
CF_DNS_API_TOKEN=paste-the-api-token
