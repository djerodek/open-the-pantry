# Optional HTTPS through Traefik -- see README, "Optional: HTTPS on your
# network". For DNS hosts OTHER than cPanel. With cPanel, don't use this
# file: Settings -> HTTPS in the app does it with no extra containers, and
# running both would have two clients asking Let's Encrypt for the same
# name (5 certificates a week between them).
#
# Copy to .env next to docker-compose.yml and fill in. The app container
# reads .env too, so it holds no secrets: the DNS host's API token goes in
# traefik.env (from traefik.env.example), which only Traefik reads.

# Makes `docker compose up -d` use both files, so nothing else changes in
# how you start or update the app.
COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml

# The name you'll open the app at. A DNS A record for it must point at the
# machine running the app (its LAN address is fine, e.g. 192.168.1.20).
PANTRY_DOMAIN=pantry.example.com

# Let's Encrypt contacts this address about certificate problems.
ACME_EMAIL=you@example.com

# Port for https://. 443 gives a URL with no port in it; if something on
# the machine already uses 443 (a NAS web interface often does), pick
# another, e.g. 8443, and open https://pantry.example.com:8443.
PANTRY_HTTPS_PORT=443

# Your DNS host, by its code in the list Traefik uses (lego):
# https://go-acme.github.io/lego/dns/ -- e.g. cloudflare, ovh, gandiv5.
# Its API variables go in traefik.env.
ACME_DNS_PROVIDER=cloudflare

# Only if 172.31.250.0/24 is already used on this machine: another private
# range, and an address in it for Traefik.
# PANTRY_NETWORK_SUBNET=172.31.250.0/24
# PANTRY_TRAEFIK_IP=172.31.250.10
