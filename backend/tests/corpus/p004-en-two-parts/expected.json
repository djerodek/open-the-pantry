{
  "title": "Fish cakes",
  "ingredients": [
    "500 g cod",
    "2 potatoes, boiled",
    "1 egg",
    "Tartar sauce:",
    "1/2 cup mayonnaise",
    "1 tbsp capers, chopped",
    "1 tbsp pickles, chopped"
  ],
  "steps": [
    "Mash the potatoes, flake in the cod and bind with the egg. Shape into cakes and fry until golden.",
    "Tartar sauce:",
    "Stir everything together and chill."
  ],
  "servings": null
}
